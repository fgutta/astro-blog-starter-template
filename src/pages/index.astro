---
// src/pages/index.astro
// Drop this file into your existing Astro blog starter project at src/pages/index.astro
// No other files need to change — this is self-contained.

const SITE_NAME  = "Avantis Solution Financière Inc.";
const SITE_URL   = "https://avantisfs.ca";
const EMAIL      = "info@avantisfs.ca";
const PHONE      = "+1 (514) 000-0000"; // ← update with real number
const CITY       = "Montréal, Québec";
---

<!DOCTYPE html>
<html lang="fr" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0D1B2A" />

  <title>Avantis Solution Financière Inc. | Conseiller Financier Montréal</title>
  <meta name="description" content="Cabinet de conseil financier privé à Montréal. Assurance collective, assurance de personnes et gestion de patrimoine pour entrepreneurs, professionnels et particuliers à valeur nette élevée. Prenez contact dès aujourd'hui." />

  <link rel="canonical" href={SITE_URL} />
  <link rel="alternate" hreflang="fr-CA" href={SITE_URL} />
  <link rel="alternate" hreflang="en-CA" href={`${SITE_URL}/en`} />
  <link rel="alternate" hreflang="x-default" href={SITE_URL} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={SITE_URL} />
  <meta property="og:title"       content="Avantis Solution Financière Inc. | Conseiller Financier Montréal" />
  <meta property="og:description" content="Cabinet de conseil financier privé à Montréal spécialisé en gestion de patrimoine pour entrepreneurs et professionnels." />
  <meta property="og:site_name"   content={SITE_NAME} />

  <!-- Schema — LocalBusiness + FinancialService -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["FinancialService", "LocalBusiness"],
    "name": SITE_NAME,
    "url": SITE_URL,
    "email": EMAIL,
    "description": "Cabinet de conseil patrimonial privé à Montréal, spécialisé en assurance collective, assurance de personnes et gestion de patrimoine pour entrepreneurs, professionnels et particuliers à valeur nette élevée.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Montréal",
      "addressRegion": "QC",
      "addressCountry": "CA"
    },
    "areaServed": ["Montréal","Laval","Longueuil","Rive-Nord","Rive-Sud"],
    "knowsLanguage": ["fr-CA","en-CA"],
    "serviceType": ["Assurance collective","Assurance vie","Assurance invalidité","Gestion de patrimoine","Planification successorale"]
  })} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" />

  <style>
    /* ── Reset & tokens ─────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { font-size: 16px; scroll-behavior: smooth; }

    :root {
      --ink:      #0D1B2A;
      --ink-soft: #1E2F42;
      --gold:     #B8933A;
      --gold-lt:  #D4AF62;
      --gold-dim: rgba(184,147,58,.18);
      --stone:    #F2EDE4;
      --stone-dk: #E5DDD0;
      --warm:     #FAF8F4;
      --slate:    #5C6B7A;
      --white:    #FFFFFF;
      --ff-serif: 'Playfair Display', Georgia, serif;
      --ff-sans:  'Jost', system-ui, sans-serif;
      --ease:     cubic-bezier(.25,.1,.25,1);
    }

    body {
      font-family: var(--ff-sans);
      font-weight: 300;
      background: var(--ink);
      color: var(--white);
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* ── Scrollbar ──────────────────────────────────── */
    ::-webkit-scrollbar { width: 3px; }
    ::-webkit-scrollbar-track { background: var(--ink); }
    ::-webkit-scrollbar-thumb { background: var(--gold); }

    /* ── Background texture ─────────────────────────── */
    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse 70% 50% at 80% 20%, rgba(184,147,58,.07) 0%, transparent 60%),
        radial-gradient(ellipse 50% 40% at 10% 80%, rgba(184,147,58,.04) 0%, transparent 55%);
      pointer-events: none;
    }

    /* ── Layout wrapper ─────────────────────────────── */
    .page {
      position: relative; z-index: 1;
      display: flex; flex-direction: column;
      min-height: 100dvh;
    }

    /* ── Header / Nav ───────────────────────────────── */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.6rem clamp(1.5rem, 6vw, 5rem);
      border-bottom: 1px solid rgba(184,147,58,.12);
    }

    .logo { text-decoration: none; }
    .logo__name {
      font-family: var(--ff-serif);
      font-size: clamp(1rem, 2.5vw, 1.3rem);
      font-weight: 400;
      color: var(--white);
      letter-spacing: .04em;
      display: block;
      line-height: 1;
    }
    .logo__sub {
      font-size: clamp(.5rem, 1.2vw, .55rem);
      font-weight: 400;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--gold);
      display: block;
      margin-top: 3px;
    }

    .header-cta {
      font-size: .68rem;
      font-weight: 400;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--gold);
      border: 1px solid rgba(184,147,58,.35);
      padding: 9px 22px;
      border-radius: 2px;
      text-decoration: none;
      transition: background .25s var(--ease), color .25s var(--ease);
      white-space: nowrap;
    }
    .header-cta:hover { background: var(--gold); color: var(--ink); }

    /* ── Main content ───────────────────────────────── */
    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 6vw, 5rem) 0;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
    }

    /* ── Eyebrow ────────────────────────────────────── */
    .eyebrow {
      display: flex;
      align-items: center;
      gap: .8rem;
      font-size: .62rem;
      font-weight: 400;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1.8rem;
    }
    .eyebrow::before {
      content: '';
      width: 28px; height: 1px;
      background: var(--gold);
      flex-shrink: 0;
    }

    /* ── Hero heading ───────────────────────────────── */
    .hero-title {
      font-family: var(--ff-serif);
      font-size: clamp(2.6rem, 6vw, 5rem);
      font-weight: 300;
      line-height: 1.1;
      color: var(--white);
      margin-bottom: 2rem;
      max-width: 800px;
    }
    .hero-title em {
      font-style: italic;
      color: var(--gold-lt);
    }

    .hero-body {
      font-size: clamp(.9rem, 1.5vw, 1rem);
      font-weight: 300;
      line-height: 1.85;
      color: rgba(255,255,255,.55);
      max-width: 580px;
      border-left: 2px solid var(--gold-dim);
      padding-left: 1.5rem;
      margin-bottom: 3rem;
    }

    /* ── CTA buttons ────────────────────────────────── */
    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 5rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      font-family: var(--ff-sans);
      font-size: .72rem;
      font-weight: 500;
      letter-spacing: .15em;
      text-transform: uppercase;
      padding: 15px 36px;
      border-radius: 2px;
      text-decoration: none;
      transition: all .3s var(--ease);
      border: none;
      cursor: pointer;
    }
    .btn--gold  { background: var(--gold); color: var(--ink); }
    .btn--gold:hover  { background: var(--gold-lt); letter-spacing: .2em; }
    .btn--ghost { border: 1px solid rgba(255,255,255,.2); color: rgba(255,255,255,.8); background: transparent; }
    .btn--ghost:hover { border-color: var(--gold); color: var(--white); }

    /* ── Services strip ─────────────────────────────── */
    .services-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: rgba(184,147,58,.15);
      border: 1px solid rgba(184,147,58,.15);
      margin-bottom: 5rem;
    }

    .svc-card {
      background: rgba(255,255,255,.02);
      padding: 2.2rem 1.8rem;
      transition: background .3s;
    }
    .svc-card:hover { background: rgba(184,147,58,.05); }

    .svc-card__num {
      font-family: var(--ff-serif);
      font-size: 2.2rem;
      font-weight: 300;
      color: rgba(184,147,58,.15);
      line-height: 1;
      margin-bottom: 1rem;
    }
    .svc-card__title {
      font-family: var(--ff-serif);
      font-size: 1.05rem;
      font-weight: 400;
      color: var(--white);
      margin-bottom: .7rem;
      line-height: 1.3;
    }
    .svc-card__body {
      font-size: .8rem;
      line-height: 1.8;
      color: rgba(255,255,255,.4);
    }

    /* ── Contact section ────────────────────────────── */
    .contact-section {
      background: rgba(184,147,58,.06);
      border: 1px solid rgba(184,147,58,.18);
      border-radius: 2px;
      padding: 3rem 3rem;
      margin-bottom: 5rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .contact-heading {
      font-family: var(--ff-serif);
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      font-weight: 300;
      line-height: 1.2;
      color: var(--white);
      margin-bottom: .8rem;
    }
    .contact-heading em { font-style: italic; color: var(--gold-lt); }

    .contact-sub {
      font-size: .85rem;
      line-height: 1.8;
      color: rgba(255,255,255,.45);
    }

    /* ── Contact form ───────────────────────────────── */
    .form { display: flex; flex-direction: column; gap: 1rem; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    .field { display: flex; flex-direction: column; gap: .4rem; }
    .field label {
      font-size: .65rem;
      font-weight: 500;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: rgba(255,255,255,.45);
    }
    .field input,
    .field select,
    .field textarea {
      font-family: var(--ff-sans);
      font-size: .85rem;
      font-weight: 300;
      color: var(--white);
      background: rgba(255,255,255,.05);
      border: 1px solid rgba(184,147,58,.25);
      border-radius: 2px;
      padding: .8rem 1rem;
      outline: none;
      transition: border-color .2s;
      width: 100%;
      -webkit-appearance: none;
    }
    .field input::placeholder,
    .field textarea::placeholder { color: rgba(255,255,255,.2); }
    .field input:focus,
    .field select:focus,
    .field textarea:focus { border-color: var(--gold); }
    .field select option { background: var(--ink-soft); color: var(--white); }
    .field textarea { resize: vertical; min-height: 100px; }

    .form-submit {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .form-note {
      font-size: .7rem;
      color: rgba(255,255,255,.25);
      line-height: 1.5;
    }

    /* ── Gold rule ──────────────────────────────────── */
    .gold-rule { width: 32px; height: 1px; background: var(--gold); margin: 1.2rem 0 1.8rem; }

    /* ── Direct contact links ───────────────────────── */
    .contact-links {
      display: flex;
      flex-direction: column;
      gap: .8rem;
      margin-top: 1.5rem;
    }
    .contact-link {
      display: flex;
      align-items: center;
      gap: .8rem;
      font-size: .82rem;
      color: rgba(255,255,255,.5);
      text-decoration: none;
      transition: color .2s;
    }
    .contact-link:hover { color: var(--gold); }
    .contact-link__icon {
      width: 28px; height: 28px;
      border: 1px solid rgba(184,147,58,.3);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: .75rem;
      color: var(--gold);
      flex-shrink: 0;
    }

    /* ── Disclaimer ─────────────────────────────────── */
    .disclaimer-strip {
      border-top: 1px solid rgba(255,255,255,.06);
      padding: 2rem 0;
      margin: 0 clamp(1.5rem, 6vw, 5rem);
    }
    .disclaimer-text {
      font-size: .65rem;
      line-height: 1.7;
      color: rgba(255,255,255,.2);
      max-width: 900px;
    }

    /* ── Footer ─────────────────────────────────────── */
    footer {
      border-top: 1px solid rgba(184,147,58,.1);
      padding: 1.8rem clamp(1.5rem, 6vw, 5rem);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: auto;
    }
    .footer-copy {
      font-size: .68rem;
      color: rgba(255,255,255,.2);
    }
    .footer-legal-link {
      font-size: .65rem;
      color: rgba(255,255,255,.2);
      text-decoration: none;
      letter-spacing: .08em;
      transition: color .2s;
    }
    .footer-legal-link:hover { color: var(--gold); }

    /* ── Success state ──────────────────────────────── */
    .form-success {
      display: none;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 2rem;
      gap: 1rem;
    }
    .form-success.visible { display: flex; }
    .success-icon {
      width: 48px; height: 48px;
      border: 1px solid var(--gold);
      border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      color: var(--gold);
      font-size: 1.3rem;
    }
    .success-heading {
      font-family: var(--ff-serif);
      font-size: 1.4rem;
      font-weight: 300;
      color: var(--white);
    }
    .success-body {
      font-size: .85rem;
      color: rgba(255,255,255,.45);
      line-height: 1.7;
    }

    /* ── Animations ─────────────────────────────────── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .fade-1 { animation: fadeUp .8s .1s both; }
    .fade-2 { animation: fadeUp .8s .25s both; }
    .fade-3 { animation: fadeUp .8s .4s both; }
    .fade-4 { animation: fadeUp .8s .55s both; }
    .fade-5 { animation: fadeUp .8s .7s both; }

    /* ── Responsive ─────────────────────────────────── */
    @media (max-width: 768px) {
      .services-strip { grid-template-columns: 1fr; }
      .contact-section { grid-template-columns: 1fr; gap: 2.5rem; padding: 2rem 1.5rem; }
      .form-row { grid-template-columns: 1fr; }
      .form-submit { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 480px) {
      .hero-actions { flex-direction: column; }
      .btn { text-align: center; justify-content: center; }
    }
  </style>
</head>

<body>
<div class="page">

  <!-- ── Header ──────────────────────────────────────── -->
  <header>
    <a href="/" class="logo" aria-label="Avantis Solution Financière Inc. — Accueil">
      <span class="logo__name">Avantis</span>
      <span class="logo__sub">Solution Financière Inc.</span>
    </a>
    <a href="#contact" class="header-cta">Nous joindre</a>
  </header>

  <!-- ── Main ────────────────────────────────────────── -->
  <main>

    <!-- Hero -->
    <p class="eyebrow fade-1">Conseil patrimonial privé · Montréal</p>

    <h1 class="hero-title fade-2">
      Votre patrimoine,<br />
      <em>entre bonnes mains.</em>
    </h1>

    <p class="hero-body fade-3">
      Avantis Solution Financière Inc. accompagne les entrepreneurs, professionnels 
      et particuliers à valeur nette élevée de la grande région de Montréal dans 
      la structuration, la protection et la transmission de leur patrimoine.
    </p>

    <div class="hero-actions fade-4">
      <a href="#contact" class="btn btn--gold">Amorcer la conversation</a>
      <a href="mailto:info@avantisfs.ca" class="btn btn--ghost">info@avantisfs.ca</a>
    </div>

    <!-- Services strip -->
    <div class="services-strip fade-5" aria-label="Nos services">
      <div class="svc-card">
        <div class="svc-card__num">01</div>
        <h2 class="svc-card__title">Assurance collective</h2>
        <p class="svc-card__body">
          Régimes d'avantages sociaux sur mesure pour PME et grandes entreprises — 
          santé, dentaire, invalidité, PAE et comptes de gestion santé.
        </p>
      </div>
      <div class="svc-card">
        <div class="svc-card__num">02</div>
        <h2 class="svc-card__title">Assurance de personnes</h2>
        <p class="svc-card__body">
          Vie, invalidité, maladies graves, soins de longue durée et assurance 
          vie corporative — une protection adaptée à votre réalité.
        </p>
      </div>
      <div class="svc-card">
        <div class="svc-card__num">03</div>
        <h2 class="svc-card__title">Gestion de patrimoine</h2>
        <p class="svc-card__body">
          REER, CELI, fonds distincts Sun Life, planification successorale 
          et fiscale — une vision globale de votre patrimoine.
        </p>
      </div>
    </div>

    <!-- Contact section -->
    <div class="contact-section" id="contact">
      <div>
        <h2 class="contact-heading">
          Parlons de<br /><em>votre situation.</em>
        </h2>
        <div class="gold-rule"></div>
        <p class="contact-sub">
          La première rencontre est confidentielle, sans frais et sans engagement. 
          Nous écoutons avant de recommander.
        </p>
        <div class="contact-links">
          <a href="mailto:info@avantisfs.ca" class="contact-link">
            <span class="contact-link__icon">✉</span>
            info@avantisfs.ca
          </a>
          <a href="tel:+15140000000" class="contact-link">
            <span class="contact-link__icon">☎</span>
            {PHONE}
          </a>
          <span class="contact-link">
            <span class="contact-link__icon">⊙</span>
            {CITY}
          </span>
        </div>
      </div>

      <!-- Contact form -->
      <div>
        <form
          class="form"
          id="contact-form"
          name="contact"
          method="POST"
          action="https://formspree.io/f/YOUR_FORM_ID"
          novalidate
        >
          <!-- Formspree honeypot -->
          <input type="text" name="_gotcha" style="display:none" aria-hidden="true" />
          <input type="hidden" name="_subject" value="Nouvelle demande — Avantis Solution Financière" />

          <div class="form-row">
            <div class="field">
              <label for="prenom">Prénom *</label>
              <input type="text" id="prenom" name="prenom" placeholder="Marie" required autocomplete="given-name" />
            </div>
            <div class="field">
              <label for="nom">Nom *</label>
              <input type="text" id="nom" name="nom" placeholder="Tremblay" required autocomplete="family-name" />
            </div>
          </div>

          <div class="field">
            <label for="courriel">Courriel *</label>
            <input type="email" id="courriel" name="courriel" placeholder="marie@exemple.ca" required autocomplete="email" />
          </div>

          <div class="field">
            <label for="telephone">Téléphone</label>
            <input type="tel" id="telephone" name="telephone" placeholder="514 000-0000" autocomplete="tel" />
          </div>

          <div class="field">
            <label for="sujet">Je m'intéresse à</label>
            <select id="sujet" name="sujet">
              <option value="" disabled selected>Choisir un service…</option>
              <option>Assurance collective</option>
              <option>Assurance de personnes</option>
              <option>Gestion de patrimoine</option>
              <option>Planification successorale</option>
              <option>Plusieurs services</option>
              <option>Autre</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Décrivez brièvement votre situation ou vos questions…"></textarea>
          </div>

          <div class="form-submit">
            <button type="submit" class="btn btn--gold">Envoyer →</button>
            <p class="form-note">
              Vos informations sont confidentielles<br />et ne sont jamais partagées.
            </p>
          </div>
        </form>

        <!-- Success message (shown after submit) -->
        <div class="form-success" id="form-success" aria-live="polite">
          <div class="success-icon" aria-hidden="true">✓</div>
          <p class="success-heading">Message reçu.</p>
          <p class="success-body">
            Merci de nous avoir contactés. Un membre de notre équipe 
            communiquera avec vous dans les 24 heures ouvrables.
          </p>
        </div>
      </div>
    </div>

  </main>

  <!-- ── Disclaimer ───────────────────────────────────── -->
  <div class="disclaimer-strip">
    <p class="disclaimer-text">
      Les produits d'assurance et de placement sont offerts par l'intermédiaire de Sun Life du Canada, 
      compagnie d'assurance-vie. Les fonds distincts sont soumis aux conditions du contrat de rente variable. 
      Des commissions, frais de gestion et charges peuvent être associés à ces placements. 
      Avantis Solution Financière Inc. est assujettie à la réglementation de l'Autorité des marchés financiers (AMF).
    </p>
  </div>

  <!-- ── Footer ───────────────────────────────────────── -->
  <footer>
    <span class="footer-copy">
      &copy; {new Date().getFullYear()} Avantis Solution Financière Inc. — Montréal, Québec
    </span>
    <div style="display:flex;gap:1.5rem">
      <a href="/mentions-legales" class="footer-legal-link">Mentions légales</a>
      <a href="/confidentialite"  class="footer-legal-link">Confidentialité</a>
    </div>
  </footer>

</div><!-- /page -->

<script>
  // ── Formspree AJAX submit ──────────────────────────────
  const form    = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) { btn.disabled = true; btn.textContent = 'Envoi…'; }

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' },
      });

      if (res.ok) {
        form.style.display = 'none';
        success?.classList.add('visible');
      } else {
        throw new Error('Network response was not ok');
      }
    } catch {
      if (btn) { btn.disabled = false; btn.textContent = 'Envoyer →'; }
      alert('Une erreur est survenue. Veuillez nous contacter directement à info@avantisfs.ca');
    }
  });

  // ── Smooth scroll for anchor links ────────────────────
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
      if (!href || href === '#') return;
      const target = document.querySelector(href);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

</body>
</html>
