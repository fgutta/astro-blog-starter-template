---
// src/pages/team.astro — English team page at /team/
import SitePage from '../../layouts/SitePage.astro';
import { fr } from '../../i18n/fr';
const d = fr;

const team = [
  {
    name:        'Francis Anthony Gutta',
    title_en:    'Financial Security Advisor',
    title_fr:    'Conseiller en sécurité financière',
    photo:       '/images/team/francis-gutta.webp',
    photo_alt:   'Francis Anthony Gutta — Financial Security Advisor, Avantis Solution Financière Inc.',
    email:       'francis@avantisfs.ca',
    phone:       '+1 (514) 000-0000',
    linkedin:    'https://linkedin.com/in/francisanthonygutta',
    calendly:    'https://calendly.com/avantisfs',
    languages:   ['English', 'French', 'Italian', 'Spanish'],
    designations: ['Financial Security Advisor', 'AMF Registered'],
    specialties: [
      'Group Insurance & Employee Benefits',
      'Corporate-Owned Life Insurance (COLI)',
      'Individual Pension Plan (IPP)',
      'Wealth Management & Estate Planning',
      'Business Succession Strategies',
      'Segregated Funds — Sun Life',
    ],
    bio_short: 'Founder of Avantis Solution Financière Inc., Francis specializes in integrated financial strategies for business owners, incorporated professionals, and high-net-worth individuals in the Greater Montreal Area.',
    bio_long: [
      'Francis Anthony Gutta founded Avantis Solution Financière Inc. with a clear conviction: that every client deserves to understand not just what their advisor recommends, but why. With a background in engineering and a deep fluency in financial planning, Francis brings an analytical rigour to wealth management that sets him apart.',
      'He specializes in serving incorporated business owners, medical and legal professionals, and high-net-worth families across the Greater Montreal Area. His practice integrates group insurance, personal insurance, and wealth management as a coherent whole — rather than as separate products.',
      'Francis operates within the Sun Life of Canada network and is registered with the Autorité des marchés financiers (AMF) as a financial security advisor.',
    ],
    amf_reg:   '[AMF Registration Number]',
    sun_life:  true,
    lead:      true,
  },
  {
    name:        'Gina [Last Name]',
    title_en:    'Financial Security Advisor',
    title_fr:    'Conseillère en sécurité financière',
    photo:       '/images/team/gina.webp',
    photo_alt:   'Gina — Associate Financial Security Advisor, Avantis Solution Financière Inc.',
    email:       'gina@avantisfs.ca',
    phone:       '+1 (514) 000-0000',
    linkedin:    'https://linkedin.com/in/',
    calendly:    'https://calendly.com/avantisfs-gina',
    languages:   ['English', 'French', 'Tamil'],
    designations: ['Financial Security Advisor', 'AMF Registered'],
    specialties: [
      'Group Insurance & Employee Benefits',
      'Personal Insurance',
      'Health & Dental Plans',
      'Employee Assistance Programs',
      'Client Onboarding & Support',
    ],
    bio_short: 'Associate advisor at Avantis Solution Financière Inc., Gina works with employers and individuals to design and manage group benefits plans and personal insurance solutions.',
    bio_long: [
      'Gina joined Avantis Solution Financière Inc. as an associate advisor, bringing her dedication to client service and her expertise in group insurance and personal protection.',
      'She works closely with employers of all sizes to design, implement, and manage group benefits plans — from initial setup through annual renewal. Her client-first approach and multilingual capabilities allow her to serve a diverse range of clients across the Montreal region.',
      'Gina is registered with the Autorité des marchés financiers (AMF) as a financial security advisor and operates within the Sun Life of Canada network.',
    ],
    amf_reg:   '[AMF Registration Number]',
    sun_life:  true,
    lead:      false,
  },
];
---

<SitePage d={d} lang="en" page="home" canon="https://avantisfs.ca/team/">

  <!-- ═══ HERO ═══ -->
  <section class="svc-hero">
    <div class="svc-hero__inner">
      <p class="eyebrow eyebrow--light">Montreal, Quebec</p>
      <h1 class="svc-hero__h1">
        Meet the <em>Team</em>
      </h1>
      <p class="svc-hero__body">
        Avantis Solution Financière Inc. is built on the belief that great financial advice
        is personal. Our advisors take the time to understand your complete situation —
        and explain every recommendation clearly.
      </p>
    </div>
  </section>

  <!-- ═══ TEAM PROFILES ═══ -->
  <section class="team-section" aria-labelledby="team-heading">
    <h2 class="sr-only" id="team-heading">Our Advisors</h2>

    {team.map((advisor, idx) => (
      <div class={`advisor-block ${idx % 2 === 1 ? 'advisor-block--alt' : ''}`} id={advisor.name.split(' ')[0].toLowerCase()}>
        <div class="advisor-block__inner">

          <!-- Photo column -->
          <div class="advisor-photo-col">
            <div class="advisor-photo-wrap">
              <img
                src={advisor.photo}
                alt={advisor.photo_alt}
                class="advisor-photo"
                width="480"
                height="560"
                loading={idx === 0 ? 'eager' : 'lazy'}
              />
              <!-- Placeholder shown until real photo is dropped in -->
              <div class="advisor-photo-placeholder" aria-hidden="true">
                <span class="advisor-photo-placeholder__initials">
                  {advisor.name.split(' ').map((n: string) => n[0]).slice(0,2).join('')}
                </span>
              </div>
            </div>

            <!-- Contact card under photo -->
            <div class="advisor-contact-card">
              <a href={`mailto:${advisor.email}`} class="advisor-contact-item">
                <span class="advisor-contact-item__icon">✉</span>
                <span>{advisor.email}</span>
              </a>
              <a href={`tel:${advisor.phone.replace(/\s/g,'')}`} class="advisor-contact-item">
                <span class="advisor-contact-item__icon">☎</span>
                <span>{advisor.phone}</span>
              </a>
              <a href={advisor.linkedin} target="_blank" rel="noopener" class="advisor-contact-item">
                <span class="advisor-contact-item__icon">in</span>
                <span>LinkedIn Profile</span>
              </a>
              <a href={advisor.calendly} target="_blank" rel="noopener" class="advisor-book-btn">
                Book a Meeting
              </a>
            </div>
          </div>

          <!-- Content column -->
          <div class="advisor-content-col">

            <!-- Name & title -->
            <div class="advisor-header">
              <div class="advisor-header__text">
                <h2 class="advisor-name">{advisor.name}</h2>
                <p class="advisor-title">{advisor.title_en}</p>
                {advisor.lead && (
                  <p class="advisor-role">Founder & Lead Advisor</p>
                )}
              </div>
              {advisor.sun_life && (
                <div class="advisor-sunlife-badge" title="Sun Life of Canada Network">
                  <span class="advisor-sunlife-badge__text">Sun Life Network</span>
                </div>
              )}
            </div>

            <div class="gold-rule" style="margin:1.2rem 0 1.8rem"></div>

            <!-- Bio -->
            <div class="advisor-bio">
              {advisor.bio_long.map((para: string) => (
                <p>{para}</p>
              ))}
            </div>

            <!-- Two-col grid: specialties + languages/designations -->
            <div class="advisor-details-grid">

              <div class="advisor-specialties">
                <p class="advisor-details-label">Areas of Focus</p>
                <ul class="advisor-list">
                  {advisor.specialties.map((s: string) => (
                    <li class="advisor-list-item">
                      <span class="advisor-list-dot" aria-hidden="true"></span>
                      {s}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="advisor-meta">
                <div class="advisor-meta-block">
                  <p class="advisor-details-label">Languages</p>
                  <div class="advisor-tags">
                    {advisor.languages.map((lang: string) => (
                      <span class="advisor-tag">{lang}</span>
                    ))}
                  </div>
                </div>

                <div class="advisor-meta-block" style="margin-top:1.8rem">
                  <p class="advisor-details-label">Credentials</p>
                  <div class="advisor-tags">
                    {advisor.designations.map((des: string) => (
                      <span class="advisor-tag">{des}</span>
                    ))}
                  </div>
                </div>

                <div class="advisor-meta-block" style="margin-top:1.8rem">
                  <p class="advisor-details-label">AMF Registration</p>
                  <p class="advisor-amf">{advisor.amf_reg}</p>
                </div>
              </div>

            </div><!-- /details-grid -->
          </div><!-- /content-col -->
        </div><!-- /inner -->
      </div>
    ))}

  </section>

  <!-- ═══ REGULATORY NOTE ═══ -->
  <div class="team-disclaimer">
    <div class="team-disclaimer__inner">
      <p class="eyebrow" style="margin-bottom:1rem">Regulatory Information</p>
      <p>
        All advisors at Avantis Solution Financière Inc. are registered with the
        <strong>Autorité des marchés financiers (AMF)</strong> and operate within the
        <strong>Sun Life of Canada</strong> distribution network. You can verify
        registrations at <a href="https://lautorite.qc.ca/en/general-public/registers/" target="_blank" rel="noopener">lautorite.qc.ca</a>.
        Insurance products are offered through Sun Life Assurance Company of Canada.
      </p>
    </div>
  </div>

  <!-- ═══ CTA ═══ -->
  <section class="cta-banner" id="contact">
    <div>
      <h2 class="cta-banner__h2">
        Not sure who to talk to? <em>Either of us will do.</em>
      </h2>
      <p class="cta-banner__sub">
        Reach out directly and we'll match you with the right advisor for your situation.
      </p>
    </div>
    <div style="position:relative;z-index:1">
      <a href="mailto:info@avantisfs.ca" class="btn btn--gold">Get in Touch</a>
    </div>
  </section>

</SitePage>

<style>
  /* ── Team section wrapper ── */
  .team-section {
    background: var(--warm);
  }

  /* ── Advisor block ── */
  .advisor-block {
    padding: 5rem clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--stone-dk);
  }
  .advisor-block--alt {
    background: var(--stone);
  }
  .advisor-block__inner {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 5rem;
    max-width: 1100px;
    margin: 0 auto;
    align-items: start;
  }

  /* ── Photo column ── */
  .advisor-photo-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: calc(72px + 2rem);
  }

  .advisor-photo-wrap {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 2px;
    overflow: hidden;
    background: var(--ink-soft);
    border: 1px solid rgba(184,147,58,.15);
  }

  .advisor-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    position: absolute;
    inset: 0;
    /* Hide until real photo is present */
    opacity: 0;
    transition: opacity .3s;
  }
  /* Show real photo if it loads successfully */
  .advisor-photo[src]:not([src=""]):not([src*="placeholder"]) {
    opacity: 1;
  }

  /* Placeholder initials while no photo */
  .advisor-photo-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, var(--ink-soft), var(--ink));
  }
  .advisor-photo-placeholder::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 70% 30%, rgba(184,147,58,.1), transparent 60%);
  }
  .advisor-photo-placeholder__initials {
    font-family: var(--ff-serif, 'Playfair Display', serif);
    font-size: 3.5rem;
    font-weight: 300;
    color: rgba(184,147,58,.4);
    position: relative;
    z-index: 1;
    letter-spacing: .1em;
  }

  /* Contact card */
  .advisor-contact-card {
    background: var(--ink);
    border: 1px solid rgba(184,147,58,.15);
    border-radius: 2px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: .8rem;
  }

  .advisor-contact-item {
    display: flex;
    align-items: center;
    gap: .75rem;
    font-size: .78rem;
    color: rgba(255,255,255,.5);
    text-decoration: none;
    transition: color .2s;
    word-break: break-all;
  }
  .advisor-contact-item:hover { color: var(--gold); }
  .advisor-contact-item__icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    border: 1px solid rgba(184,147,58,.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .65rem;
    color: var(--gold);
    flex-shrink: 0;
  }

  .advisor-book-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: .4rem;
    padding: 11px;
    background: var(--gold);
    color: var(--ink);
    border-radius: 2px;
    font-family: var(--ff-sans, 'Jost', sans-serif);
    font-size: .68rem;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background .25s;
  }
  .advisor-book-btn:hover { background: var(--gold-lt, #D4AF62); }

  /* ── Content column ── */
  .advisor-content-col {}

  .advisor-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .advisor-name {
    font-family: var(--ff-serif, 'Playfair Display', serif);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 300;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: .3rem;
  }
  .advisor-title {
    font-size: .78rem;
    font-weight: 400;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .advisor-role {
    font-size: .72rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--slate);
    margin-top: .3rem;
  }

  /* Sun Life badge */
  .advisor-sunlife-badge {
    border: 1px solid rgba(184,147,58,.25);
    padding: 6px 14px;
    border-radius: 2px;
    flex-shrink: 0;
    margin-top: .25rem;
  }
  .advisor-sunlife-badge__text {
    font-size: .6rem;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--gold);
    white-space: nowrap;
  }

  /* Bio */
  .advisor-bio {
    display: flex;
    flex-direction: column;
    gap: .9rem;
    margin-bottom: 2.5rem;
  }
  .advisor-bio p {
    font-size: .9rem;
    line-height: 1.9;
    color: var(--slate);
  }

  /* Details grid */
  .advisor-details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    border-top: 1px solid var(--stone-dk);
    padding-top: 2rem;
  }

  .advisor-details-label {
    font-size: .6rem;
    font-weight: 500;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: .8rem;
  }

  /* Specialty list */
  .advisor-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .55rem;
  }
  .advisor-list-item {
    display: flex;
    align-items: flex-start;
    gap: .7rem;
    font-size: .83rem;
    color: var(--slate);
    line-height: 1.5;
  }
  .advisor-list-dot {
    width: 5px;
    height: 5px;
    min-width: 5px;
    border-radius: 50%;
    background: var(--gold);
    margin-top: .42rem;
    flex-shrink: 0;
  }

  /* Tags */
  .advisor-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
  }
  .advisor-tag {
    font-size: .62rem;
    font-weight: 400;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid var(--stone-dk);
    color: var(--slate);
    border-radius: 1px;
  }

  /* AMF */
  .advisor-amf {
    font-size: .8rem;
    color: var(--slate);
    font-family: 'Courier New', monospace;
  }

  /* Regulatory disclaimer */
  .team-disclaimer {
    background: var(--ink);
    padding: 3rem clamp(1.5rem, 5vw, 5rem);
    border-top: 1px solid rgba(184,147,58,.12);
  }
  .team-disclaimer__inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .team-disclaimer p {
    font-size: .82rem;
    line-height: 1.8;
    color: rgba(255,255,255,.4);
  }
  .team-disclaimer strong { color: rgba(255,255,255,.7); font-weight: 500; }
  .team-disclaimer a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }

  /* Screen reader only */
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0,0,0,0);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .advisor-block__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .advisor-photo-col {
      position: static;
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 1.5rem;
      align-items: start;
    }
    .advisor-photo-wrap { aspect-ratio: 3/4; }
    .advisor-details-grid { grid-template-columns: 1fr; gap: 1.8rem; }
  }

  @media (max-width: 600px) {
    .advisor-photo-col { grid-template-columns: 1fr; }
    .advisor-block { padding: 3rem 1.5rem; }
    .advisor-header { flex-direction: column; gap: .8rem; }
  }
</style>
